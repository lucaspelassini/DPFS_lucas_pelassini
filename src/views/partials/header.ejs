<header class="header">
    <div class="header-left">
        <div class="logo">LOGO</div>
        <h1 class="brand">
            <a href="/" style="text-decoration: none; color: inherit;">Botánica.com</a>
        </h1>
    </div>

    <form action="/products/search" method="GET" class="search-form">
        <input type="text" name="q" placeholder="Buscar productos..." class="search-input" required>
        <button type="submit" class="search-btn">Buscar</button>
    </form>

    <nav class="nav">
        <a href="/">Home</a>
        <a href="/products">Productos</a>
        <a href="/products/cart" style="position: relative;">
            Carrito
            <span id="cart-count" style="background: #d9534f; color: white; border-radius: 50%; padding: 2px 6px; font-size: 12px; margin-left: 5px; display: inline-block; min-width: 20px; text-align: center;">0</span>
        </a>
        
        <% if (locals.isLogged) { %>
            <a href="/users/profile">Hola, <%= userLogged.firstName %></a>
            <a href="/users/logout">Cerrar Sesión</a>
        <% } else { %>
            <a href="/users/login">Login</a>
            <a href="/users/register">Registro</a>
        <% } %>
    </nav>
</header>

<script src="/js/cart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        updateCartCount();
    });
</script>