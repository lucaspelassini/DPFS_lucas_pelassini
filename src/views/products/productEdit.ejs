<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head', { title: 'Editar Producto - Botánica.com', stylesheet: 'forms' }) %>

<body>

<%- include('../partials/header') %>

<div class="container">
    <div class="form-container">
        <h2>Editar Producto</h2>
        <p class="form-subtitle">Modifica los datos del producto</p>

        <form action="/products/<%= product.id %>?_method=PUT" method="POST">
    
    <div class="form-group">
        <label for="name">Nombre del Producto *</label>
        <input type="text" id="name" name="name" value="<%= locals.old ? old.name : product.name %>" required>
        <% if (locals.errors && errors.name) { %>
            <small class="error-msg"><%= errors.name.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="description">Descripción *</label>
        <textarea id="description" name="description" rows="5" required><%= locals.old ? old.description : product.description %></textarea>
        <% if (locals.errors && errors.description) { %>
            <small class="error-msg"><%= errors.description.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label>Imagen Actual:</label>
        <p><%= product.image %></p>
        <small>Para cambiar la imagen, deberás eliminar y crear de nuevo el producto</small>
    </div>

    <div class="form-group">
        <label for="category">Categoría *</label>
        <select id="category" name="category" required>
            <option value="">Seleccionar categoría</option>
            <% categories.forEach(cat => { %>
                <% 
                    let selected = false;
                    if (locals.old) {
                        selected = old.category == cat.id;
                    } else {
                        selected = product.categoryId === cat.id;
                    }
                %>
                <option value="<%= cat.id %>" <%= selected ? 'selected' : '' %>>
                    <%= cat.name %>
                </option>
            <% }); %>
        </select>
        <% if (locals.errors && errors.category) { %>
            <small class="error-msg"><%= errors.category.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="colors">Colores disponibles</label>
        <% 
            let colorsValue = '';
            if (locals.old) {
                colorsValue = old.colors;
            } else if (product.colors) {
                colorsValue = product.colors.map(c => c.color).join(', ');
            }
        %>
        <input type="text" id="colors" name="colors" value="<%= colorsValue %>" placeholder="Ej: Verde, Rojo, Amarillo">
    </div>

    <div class="form-group">
        <label for="price">Precio *</label>
        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= locals.old ? old.price : product.price %>" required>
        <% if (locals.errors && errors.price) { %>
            <small class="error-msg"><%= errors.price.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="stock">Stock</label>
        <input type="number" id="stock" name="stock" min="0" value="<%= locals.old ? old.stock : product.stock %>">
        <% if (locals.errors && errors.stock) { %>
            <small class="error-msg"><%= errors.stock.msg %></small>
        <% } %>
    </div>

    <div class="form-buttons">
        <button type="submit" class="btn-main">Guardar Cambios</button>
        <a href="/products/<%= product.id %>" class="btn-secondary">Cancelar</a>
    </div>
</form>

        <form action="/products/<%= product.id %>?_method=DELETE" method="POST" class="delete-form">
            <button type="submit" class="btn-delete" onclick="return confirm('¿Estás seguro de eliminar este producto?')">Eliminar Producto</button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/products.js"></script>

</body>
</html>