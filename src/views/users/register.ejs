<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head', { title: 'Registro - Botánica.com', stylesheet: 'register' }) %>

<body>

<%- include('../partials/header') %>

<main class="register-container">
    <div class="register-box">
        <h2>Crear Cuenta</h2>
        <p class="bienvenida">Únete a Botánica.com</p>

        <form action="/users/register" method="POST" enctype="multipart/form-data">
    <div class="form-group">
        <label for="firstName">Nombre *</label>
        <input type="text" id="firstName" name="firstName" value="<%= locals.old ? old.firstName : '' %>" required />
        <% if (locals.errors && errors.firstName) { %>
            <small class="error-msg"><%= errors.firstName.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="lastName">Apellido *</label>
        <input type="text" id="lastName" name="lastName" value="<%= locals.old ? old.lastName : '' %>" required />
        <% if (locals.errors && errors.lastName) { %>
            <small class="error-msg"><%= errors.lastName.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="email">Correo Electrónico *</label>
        <input type="email" id="email" name="email" value="<%= locals.old ? old.email : '' %>" required />
        <% if (locals.errors && errors.email) { %>
            <small class="error-msg"><%= errors.email.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="image">Imagen de Perfil</label>
        <input type="file" id="image" name="image" accept="image/*" />
        <% if (locals.errors && errors.image) { %>
            <small class="error-msg"><%= errors.image.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="password">Contraseña *</label>
        <input type="password" id="password" name="password" required />
        <% if (locals.errors && errors.password) { %>
            <small class="error-msg"><%= errors.password.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="password2">Confirmar Contraseña *</label>
        <input type="password" id="password2" name="password2" required />
        <% if (locals.errors && errors.password2) { %>
            <small class="error-msg"><%= errors.password2.msg %></small>
        <% } %>
    </div>

    <button type="submit" class="btn-main">Crear Cuenta</button>
</form>
        <p class="login-link">
            ¿Ya tienes cuenta? <a href="/users/login">Inicia sesión aquí</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>
<script src="/js/register.js"></script>

</body>
</html>