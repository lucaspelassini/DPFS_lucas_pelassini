<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head', { title: 'Perfil - Botánica.com', stylesheet: 'profile' }) %>

<body>

<%- include('../partials/header') %>

<div class="container">
    <div class="profile-container">
        <h2>Mi Perfil</h2>

        <div class="profile-card">
            <div class="profile-image">
                <img src="/img/users/<%= user.image %>" alt="<%= user.firstName %>">
            </div>

            <div class="profile-info">
                <h3><%= user.firstName %> <%= user.lastName %></h3>
                <p class="email"><%= user.email %></p>
                <p class="category">Tipo de cuenta: <%= user.category %></p>

                <div style="display: flex; gap: 15px; justify-content: center; margin-top: 20px;">
                    <a href="/users/<%= user.id %>/edit" class="btn-secondary">Editar Perfil</a>
                    <a href="/users/logout" class="btn-main">Cerrar Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

</body>
</html>