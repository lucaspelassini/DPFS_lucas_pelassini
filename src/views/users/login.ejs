<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head', { title: 'Login - Botánica.com', stylesheet: 'login' }) %>

<body>

<%- include('../partials/header') %>

<main class="login-container">
    <div class="login-box">
        <h2>Iniciar Sesión</h2>
        <p class="bienvenida">Bienvenido a Botánica.com</p>

        <form action="/users/login" method="POST">
    <div class="form-group">
        <label for="email">Correo Electrónico *</label>
        <input type="email" id="email" name="email" value="<%= locals.old ? old.email : '' %>" required />
        <% if (locals.errors && errors.email) { %>
            <small class="error-msg"><%= errors.email.msg %></small>
        <% } %>
    </div>

    <div class="form-group">
        <label for="password">Contraseña *</label>
        <input type="password" id="password" name="password" required />
        <% if (locals.errors && errors.password) { %>
            <small class="error-msg"><%= errors.password.msg %></small>
        <% } %>
    </div>

    <div class="extras">
        <label class="recordarme">
            <input type="checkbox" name="remember" />
            Recordarme
        </label>

        <a href="#" class="olvide">Olvidé Contraseña</a>
    </div>

    <button type="submit" class="btn-main">Iniciar Sesión</button>
</form>

        <p class="register-link">
            ¿No tienes cuenta? <a href="/users/register">Regístrate aquí</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>
<script src="/js/login.js"></script>

</body>
</html>